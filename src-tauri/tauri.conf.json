{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zenner",
  "version": "1.8.4",
  "identifier": "com.anweshrath.zenner",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Zenner",
        "width": 1200,
        "height": 800,
        "minWidth": 300,
        "minHeight": 150,
        "transparent": true,
        "decorations": false,
        "devtools": true
      },
      {
        "label": "spotlight",
        "title": "Zenner Spotlight",
        "width": 800,
        "height": 60,
        "x": 0,
        "y": 200,
        "center": true,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "url": "index.html?mode=spotlight"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}